.tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;z-index:90;background:#fff;border-top:1rpx solid #eef0ee;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 25rpx #35463805}.tab-item{width:25%;display:flex;align-items:center;flex-direction:column;gap:5rpx;color:#a2aaa6;font-size:19rpx}.tab-icon{font-size:44rpx;height:52rpx;line-height:48rpx;position:relative}.selected{color:#c15c50}.merchant .selected{color:#4382b7}.agent .selected{color:#8c6eb5}.tab-dot{position:absolute;width:7rpx;height:7rpx;border-radius:50%;background:currentColor;right:-12rpx;top:8rpx}

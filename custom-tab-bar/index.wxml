<view class="tab-bar {{role}}"><view class="tab-item {{selected===index?'selected':''}}" wx:for="{{items}}" wx:key="path" bindtap="switchTab" data-index="{{index}}"><view class="tab-icon">{{item.icon}}<view wx:if="{{selected===index}}" class="tab-dot"></view></view><text>{{item.text}}</text></view></view>

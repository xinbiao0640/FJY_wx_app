.game{background:#fbf3e9;border:1rpx solid #eee2cf;border-radius:22rpx;padding:28rpx;margin:25rpx 0;color:#b58b60}.game-kicker{text-align:center;letter-spacing:3rpx;font-size:21rpx;margin-bottom:28rpx}.wheel-wrap{position:relative;width:400rpx;height:400rpx;margin:10rpx auto 30rpx}.wheel{width:100%;height:100%;border:17rpx solid #d5af7f;box-sizing:border-box;border-radius:50%;background:conic-gradient(#f4dcc0 0deg 90deg,#fff5e7 90deg 180deg,#f4dcc0 180deg 270deg,#fff5e7 270deg 360deg);position:relative;box-shadow:0 8rpx 0 #c9a27155}.wheel-label{position:absolute;font-size:23rpx;color:#ad8055}.l1{top:65rpx;right:25rpx;transform:rotate(40deg)}.l2{right:25rpx;bottom:70rpx;transform:rotate(-40deg)}.l3{left:35rpx;bottom:70rpx;transform:rotate(40deg)}.l4{left:25rpx;top:65rpx;transform:rotate(-40deg)}.wheel-button{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:130rpx;height:130rpx;border:8rpx solid #fce8cc;border-radius:50%;background:#be7d56;color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:23rpx;box-sizing:border-box}.wheel-button text{font-size:20rpx;margin-top:6rpx}.pointer{position:absolute;left:186rpx;top:-9rpx;border-left:14rpx solid transparent;border-right:14rpx solid transparent;border-top:45rpx solid #b4724b}.scratch{background:#fff9f0;border:2rpx dashed #d7ba93;border-radius:14rpx;text-align:center;padding:30rpx 20rpx}.scratch-title{font-size:26rpx}.scratch-mask{margin:30rpx 0 20rpx;padding:25rpx;background:repeating-linear-gradient(135deg,#d8cfc1,#d8cfc1 8rpx,#e0d8ca 8rpx,#e0d8ca 16rpx);border:1rpx solid #c9bdab;border-radius:10rpx;color:#9c8d79;display:flex;flex-direction:column;gap:15rpx;font-size:23rpx}.scratch-mask text:first-child{font-size:50rpx}.scratch-note,.game-note{font-size:18rpx;color:#b6a48c}.game-note{text-align:center;margin-top:23rpx;font-size:17rpx;line-height:1.8}.nine-grid{display:flex;flex-wrap:wrap;gap:14rpx}.grid-cell{width:calc((100% - 28rpx)/3);height:137rpx;background:#fff9ed;border:1rpx solid #ead4b0;border-radius:13rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10rpx;font-size:36rpx;color:#c5a471;box-shadow:0 5rpx 0 #e4cda84d}.grid-small{font-size:18rpx}.grid-center{background:#bd865d;color:#fff;font-size:23rpx}.direct{text-align:center;background:#fff9ee;border:2rpx dashed #dec6a0;padding:30rpx;border-radius:16rpx;display:flex;flex-direction:column;gap:25rpx;font-size:25rpx}.direct>view{font-size:90rpx;color:#c5a571}.direct-button{background:#bb825b;color:#fff;border-radius:35rpx;padding:18rpx;font-size:23rpx}

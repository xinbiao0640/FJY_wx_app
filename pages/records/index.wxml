<view class="page {{role}} "><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="heading-title">{{optionsType==='activities'?'我的活动':'业务记录'}}</view><view class="subtitle">每一笔变化，都有迹可循。</view><view style="margin-top:30rpx"><view class="card record" wx:for="{{rows}}" wx:key="id"><view class="row"><view class="name">{{item.name}}</view><text class="status">{{labels[item.status]||item.status}}</text></view><view class="muted">{{item.betCount||item.quantity||item.quotaBets||0}} 注 {{item.amount?' · ¥'+item.amount:''}}</view><view class="id">{{item.id}}</view><view class="record-actions" wx:if="{{item.quotaBets}}"><button wx:if="{{item.status!=='DRAFT'}}" class="secondary small" bindtap="showActivityCode" data-id="{{item.id}}" disabled="{{busy}}">活动码</button><button wx:if="{{item.status==='DRAFT'}}" class="secondary small" bindtap="activityAction" data-id="{{item.id}}" data-action="publish">发布</button><button wx:if="{{item.status==='RUNNING'}}" class="secondary small" bindtap="activityAction" data-id="{{item.id}}" data-action="pause">暂停</button><button wx:if="{{item.status==='PAUSED'}}" class="secondary small" bindtap="activityAction" data-id="{{item.id}}" data-action="resume">恢复</button><button wx:if="{{item.status==='RUNNING'||item.status==='PAUSED'}}" class="secondary small" bindtap="activityAction" data-id="{{item.id}}" data-action="end">结束</button></view></view><view wx:if="{{!rows.length}}" class="empty"><view class="symbol">▤</view><view class="title">暂无记录</view><view class="desc">新的业务动态将在这里展示</view></view></view><view wx:if="{{activityQrPath}}" class="code-backdrop"><view class="code-dialog"><view class="card-title">{{activityCodeName}}</view><image class="qr-image" src="{{activityQrPath}}" mode="aspectFit"/><view class="muted">微信扫码直接进入此活动</view><button class="primary" bindtap="saveActivityCode">保存活动码到相册</button><button class="secondary" bindtap="closeActivityCode">关闭</button></view></view></block></view>
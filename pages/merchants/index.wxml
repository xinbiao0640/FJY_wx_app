<view class="page {{role}} "><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="heading-title">一起成长的好伙伴</view><view class="subtitle">只展示当前代理名下商户。</view><view class="card" wx:for="{{merchants}}" wx:key="name" style="margin-top:25rpx"><view class="row"><view class="card-title">{{item.name}}</view><text class="status">正常经营</text></view><view class="detail-line"><text>联系人</text><text>{{item.contact}} · {{item.phone}}</text></view><view class="detail-line"><text>可用权益</text><text>{{item.balance}} 注</text></view></view><button class="primary" bindtap="open" data-path="invite">邀请新的商户</button><view class="card" style="margin-top:25rpx"><view class="card-title">申请接管商户</view><view class="field"><text class="field-label">待接管商户编号</text><input value="{{form.merchantId}}" bindinput="input" data-field="merchantId" type="number" placeholder="如：1002"/></view><view class="field"><text class="field-label">申请理由 / 休眠条件核验依据</text><textarea value="{{form.reason}}" bindinput="input" data-field="reason" placeholder="至少5字，最终由平台审核"/></view><button class="secondary" bindtap="requestOwnership" disabled="{{busy}}">提交接管申请</button><view class="field-tip">申请不直接变更首次归属，审核后才生效；历史订单卖方不变。</view></view><view class="card" wx:for="{{ownershipRequests}}" wx:key="id"><view class="row"><text>{{item.name}}</text><text class="status">{{labels[item.status]}}</text></view><view class="subtitle">{{item.reason}}</view></view></block></view>
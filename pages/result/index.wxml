<view class="page {{role}} "><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="result-head"><view class="result-icon">{{result.status==='SUCCESS'?'✦':result.status==='NO_WIN'?'✧':'◷'}}</view><view class="result-title">{{result.status==='SUCCESS'?'幸运已抵达':result.status==='NO_WIN'?'谢谢参与，下次再遇见':result.status==='PENDING_SELECTION'?'好礼已预留，去选你的幸运号':'正在为你准备幸运'}}</view><view class="result-desc">{{result.status==='NO_WIN'?'本次未中奖，参与次数已记录。':result.status==='PROCESSING'?'每2秒查询一次模拟出票状态，请稍候。':result.status==='SUCCESS'?'模拟出票已完成，可在我的权益查看。':'手选完成仅触发状态查询，最终结果仍以服务状态为准。'}}</view></view><view class="card" wx:if="{{result.status!=='NO_WIN'}}"><view class="detail-line"><text>活动</text><text>{{result.name}}</text></view><view class="detail-line"><text>权益数量</text><text>{{result.betCount}} 注</text></view><view class="detail-line"><text>当前状态</text><text>{{labels[result.status]}}</text></view><view class="detail-line" wx:for="{{result.tickets}}" wx:key="id"><text>{{item.id}}</text><text>{{item.betCount}}注 · {{item.status}}</text></view></view><button wx:if="{{result.status==='PENDING_SELECTION'}}" class="primary" bindtap="selectNumbers">去模拟选号</button><button class="secondary" bindtap="home">返回首页</button><view class="mock-note">当前全部为模拟结果，不代表真实出票或开奖。</view></block></view>
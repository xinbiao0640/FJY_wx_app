<import src="../../templates/subject-review.wxml"/>
<view class="page {{role}}"><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="eyebrow">GROW YOUR GOOD BUSINESS</view><view class="heading-title">让好生意，从这里开始</view><view class="subtitle">提交入驻申请，平台审核通过后开启商户经营台。</view><template wx:if="{{merchant}}" is="subject-review" data="{{subject:merchant}}"/><view wx:else class="card" style="margin-top:30rpx"><view class="field" wx:for="{{fields}}" wx:key="key"><text class="field-label">{{item.label}}</text><input value="{{form[item.key]}}" data-field="{{item.key}}" bindinput="input" placeholder="{{item.placeholder}}"/></view><view class="note">提交后请等待平台审核。首次归属不会自动覆盖；邀请码由代理在“邀请商户”页面生成。</view><button class="primary" bindtap="submitOnboarding" loading="{{busy}}" disabled="{{busy||loading||!!loadError}}">提交入驻申请</button></view></block></view>

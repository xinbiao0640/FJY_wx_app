<view class="page {{role}} "><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="heading-title">个人资料</view><view class="card" style="margin-top:30rpx" wx:if="{{user}}"><view class="field"><text class="field-label">昵称</text><input value="{{form.name}}" bindinput="input" data-field="name" maxlength="20"/></view><view class="detail-line"><text>绑定手机号</text><text>{{user.phone}}</text></view><view class="detail-line"><text>微信身份</text><text>{{user.wechatBound?'已模拟绑定':'未绑定'}}</text></view><button wx:if="{{!user.wechatBound}}" class="secondary" bindtap="bindWechat">模拟绑定微信</button><button class="primary" bindtap="saveProfile" loading="{{busy}}" disabled="{{busy}}">保存资料</button></view><view wx:else class="empty"><view class="title">请先登录</view><button class="primary" bindtap="open" data-path="login">去登录</button></view></block></view>
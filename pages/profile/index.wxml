<view class="page {{role}} tab-page"><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="eyebrow">MY LITTLE WORLD</view><view class="heading-title">我的</view><view class="profile-head"><view class="avatar">{{user?'幸':'♙'}}</view><view><view class="name">{{user?user.name:'遇见你的幸运'}}</view><view class="phone">{{user?user.phone:'登录后，让每一份权益都有归属'}}</view></view><view class="edit" bindtap="open" data-path="{{user?'profile-edit':'login'}}">{{user?'编辑 ›':'登录 ›'}}</view></view><view class="note" wx:if="{{user&&!user.wechatBound}}" bindtap="bindWechat">绑定微信身份后即可领奖 · 点击模拟绑定 ›</view><view class="card"><view class="card-title">身份与工作台</view><view class="menu-row" wx:for="{{roleMenus}}" wx:key="role" bindtap="switchRole" data-role="{{item.role}}"><view class="left"><text class="menu-icon">{{item.icon}}</text>{{item.name}}</view><text class="arrow">{{role===item.role?'当前身份':'进入'}} ›</text></view></view><view class="card"><view class="menu-row" wx:if="{{merchant}}" bindtap="open" data-path="onboarding" data-query="?review=1"><text>商户入驻与审核信息</text><text class="arrow">{{labels[merchant.status]||merchant.status}} ›</text></view><view class="menu-row" wx:if="{{agent}}" bindtap="open" data-path="agent-apply" data-query="?review=1"><text>代理申请与审核信息</text><text class="arrow">{{labels[agent.status]||agent.status}} ›</text></view><view class="menu-row" bindtap="open" data-path="profile-edit"><text>个人资料</text><text class="arrow">›</text></view><view class="menu-row" bindtap="resetDemo"><text>清理本机登录状态</text><text class="arrow">›</text></view><view class="menu-row" wx:if="{{user}}" bindtap="logout"><text>退出登录</text><text class="arrow">›</text></view></view><view class="mock-note">后端联调环境 · v1.1<view class="line-break"></view>业务记录保存在服务端；微信、支付与出票暂用 mock。</view></block></view>
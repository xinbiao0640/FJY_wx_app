<view class="page {{role}} "><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="heading-title">每一份好礼，安心核销</view><view class="subtitle">仅核销当前商户的有效券，一券一次。</view><view class="card" style="margin-top:30rpx"><view class="card-title">核销顾客卡券</view><button class="secondary" bindtap="scan">⌗ 扫描核销码</button><view class="field" style="margin-top:25rpx"><text class="field-label">或粘贴动态核销口令</text><input value="{{form.code}}" bindinput="input" data-field="code" placeholder="有效期60秒的一次性口令"/></view><button class="primary" bindtap="redeem" loading="{{busy}}" disabled="{{busy}}">确认核销</button></view><view class="card"><view class="card-title">创建券模板</view><view class="field"><text class="field-label">券名称</text><input value="{{form.name}}" bindinput="input" data-field="name" placeholder="如：咖啡满30减10元"/></view><view class="field"><text class="field-label">库存数量</text><input value="{{form.stock}}" type="number" bindinput="input" data-field="stock"/></view><button class="secondary" bindtap="createCoupon" disabled="{{busy}}">创建模板</button></view><view class="card" wx:for="{{couponTemplates}}" wx:key="id"><view class="row"><text>{{item.name}}</text><text class="status">库存 {{item.stock}}</text></view></view><view class="return-home" bindtap="open" data-path="records" data-query="?type=redemptions">查看核销记录 ›</view></block></view>
<view class="page {{role}} tab-page"><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="eyebrow">EVERY LITTLE GIFT COUNTS</view><view class="heading-title">我的权益</view><view class="subtitle">生活里的小幸运，都在这里好好收藏。</view><view class="tab-switch" style="margin-top:30rpx"><view wx:for="{{['权益','卡券','领礼包']}}" wx:key="*this" class="{{assetTab===item?'active':''}}" data-value="{{item}}" bindtap="selectAssetTab">{{item}}</view></view><view wx:if="{{!user}}" class="empty"><view class="symbol">▤</view><view class="title">登录后查看你的好礼</view><button class="primary" bindtap="open" data-path="login">去登录</button></view><block wx:elif="{{assetTab==='权益'}}"><view wx:for="{{claims}}" wx:key="id" class="card record" bindtap="openResult" data-id="{{item.id}}"><view class="row"><view class="name">{{item.name}}</view><text class="status">{{item.statusText}}</text></view><view class="amount">{{item.betCount}} 注</view><view class="muted">{{item.dateText}} · 查看明细 ›</view></view><view wx:if="{{!claims.length}}" class="empty"><view class="symbol">✧</view><view class="title">你的幸运正在路上</view><view class="desc">去发现页参与活动，领取第一份好礼</view></view></block><block wx:elif="{{assetTab==='卡券'}}"><view class="coupon" wx:for="{{coupons}}" wx:key="id"><view class="coupon-value"><text wx:if="{{item.value}}">¥{{item.value}}</text><text wx:else>券</text></view><view class="coupon-info"><view class="name">{{item.name}}</view><view class="expiry">{{item.merchant}} · {{labels[item.status]}}</view><view class="expiry">有效期至 {{item.expiryText}}</view><button wx:if="{{item.status==='AVAILABLE'}}" class="secondary small" bindtap="showCode" data-id="{{item.id}}">去使用</button></view></view></block><view wx:else class="card"><view class="card-title">收下为你准备的心意</view><view class="field"><text class="field-label">一次性礼包口令</text><input value="{{form.token}}" bindinput="input" data-field="token" placeholder="粘贴商户分享的礼包口令"/></view><view class="field-tip">需使用定向手机号登录并绑定微信，礼包仅能领取一次。</view><button class="primary" bindtap="claimGift" loading="{{busy}}" disabled="{{busy}}">领取礼包</button></view><view wx:if="{{codeDialog}}" class="code-backdrop"><view class="code-dialog"><view class="card-title">优惠券核销码</view><view class="body-text">请向本店店员出示，核销后不可重复使用</view><image wx:if="{{couponQrPath && codeRemaining>0}}" class="qr-image" src="{{couponQrPath}}" mode="aspectFit"/><view wx:if="{{qrError}}" class="field-tip">{{qrError}}</view><view wx:if="{{codeRemaining>0}}" class="code" user-select>{{redeemCode}}</view><view class="muted">{{codeRemaining>0?'剩余 '+codeRemaining+' 秒':'核销码已过期，请刷新'}}</view><button class="secondary" bindtap="refreshCode" disabled="{{busy}}">刷新核销码</button><button class="secondary" bindtap="closeCode">关闭</button></view></view></block></view>
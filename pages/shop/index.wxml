<view class="page {{role}} "><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="shop-sign">{{a.merchantId==='1002'?'茶':'拾'}}</view><view class="result-title">{{a.merchant}}</view><view class="result-desc">用心对待每一份日常，欢迎来店里坐坐。</view><view class="card"><view class="detail-line"><text>门店地址</text><text>浙江省杭州市 · 西湖商圈</text></view><view class="detail-line"><text>营业时间</text><text>09:00 — 21:00</text></view><view class="detail-line"><text>门店类型</text><text>生活方式 · 品质好店</text></view></view><view class="section-heading"><view class="section-title">店内好礼</view></view><view class="activity-card" wx:for="{{activities}}" wx:key="id" bindtap="openActivity" data-id="{{item.id}}"><view class="activity-cover {{item.color}}"><view class="cover-kicker">A LITTLE LUCK, A LOVELY DAY</view><view class="cover-name">{{item.merchant}}</view><view class="cover-art">{{item.color==='tea'?'茶':item.color==='market'?'礼':'啡'}}</view><text class="cover-badge">{{item.playType}}</text></view><view class="activity-body"><view class="activity-name">{{item.name}}</view><view class="merchant-name">⌂ {{item.merchant}}</view><view class="activity-bottom"><text class="reward-tag">✧ 有机会获得 {{item.betCount}} 注权益</text><text class="join-link">去参与 →</text></view></view></view></block></view>
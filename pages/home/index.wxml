<view class="page {{role}} tab-page"><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><button class="secondary scan-entry" bindtap="scanEntry">扫一扫，进入活动</button><view class="heading"><view class="logo"><text class="logo-mark">丰</text><text>丰嘉盈</text></view><view class="date">{{dateText}}</view></view><view class="hero"><view class="hero-kicker">把日常，过成好日子</view><view class="hero-title">遇见身边好店，<view class="line-break"></view>收获一份<text>小幸运。</text></view><view class="hero-sub">每一份好意，都值得被好好回应</view><view class="hero-button" bindtap="openActivity" data-id="3001">发现今日好礼 →</view><view class="hero-art"><text class="art-label">GOOD FORTUNE</text><text>幸</text></view></view><view class="section-heading"><view class="section-title">你的每一种身份<text class="en">CHOOSE YOUR JOURNEY</text></view></view><view class="role-grid"><view wx:for="{{roleEntries}}" wx:key="role" class="role-card {{item.role}}" bindtap="switchRole" data-role="{{item.role}}"><view class="role-icon">{{item.icon}}</view><text class="role-arrow">↗</text><view class="role-name">{{item.name}}</view><view class="role-desc">{{item.desc}}</view></view></view><view class="section-heading"><view class="section-title">身边的好礼<text class="en">A LITTLE LUCK NEARBY</text></view><view class="section-link" bindtap="open" data-path="shop">发现好店 ›</view></view><view class="activity-card" wx:for="{{activities}}" wx:key="id" bindtap="openActivity" data-id="{{item.id}}"><view class="activity-cover {{item.color}}"><view class="cover-kicker">A LITTLE LUCK, A LOVELY DAY</view><view class="cover-name">{{item.merchant}}</view><view class="cover-art">{{item.color==='tea'?'茶':item.color==='market'?'礼':'啡'}}</view><text class="cover-badge">{{item.playType}}</text></view><view class="activity-body"><view class="activity-name">{{item.name}}</view><view class="merchant-name">⌂ {{item.merchant}}</view><view class="activity-bottom"><text class="reward-tag">✧ 有机会获得 {{item.betCount}} 注权益</text><text class="join-link">去参与 →</text></view></view></view><view class="footnote">✧ 让每一份好意，都有回响 ✧</view></block></view>
<view class="page {{role}} "><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="eyebrow">{{role==='agent'?'INVENTORY WALLET':'ENTITLEMENT WALLET'}}</view><view class="heading-title">{{role==='agent'?'库存钱包':'权益钱包'}}</view><view class="metric-grid"><view class="metric"><text>{{wallet.availableBets}}</text><text class="metric-label">可用 / 注</text></view><view class="metric"><text>{{wallet.frozenBets}}</text><text class="metric-label">冻结 / 注</text></view><view class="metric"><text>{{wallet.consumedBets}}</text><text class="metric-label">已消耗 / 注</text></view></view><button class="primary" bindtap="open" data-path="purchase">采购权益</button><view class="card" style="margin-top:30rpx"><view class="menu-row" bindtap="open" data-path="records" data-query="?type=orders"><text>购买订单</text><text class="arrow">›</text></view><view class="menu-row" bindtap="open" data-path="refunds"><text>申请退款 / 进度</text><text class="arrow">›</text></view></view><view class="section-heading"><text class="section-title">权益流水</text><text class="muted">历史记录不可修改</text></view><view class="card" wx:for="{{ledgers}}" wx:key="id"><view class="row"><text>{{item.name}}</text><text>{{item.quantity>0?'+':''}}{{item.quantity}} 注</text></view><view class="record"><view class="id">{{item.id}}</view></view></view><view wx:if="{{!ledgers.length}}" class="empty"><view class="desc">暂无新增流水，完成一笔采购试试</view></view></block></view>
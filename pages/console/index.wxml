<view class="page {{role}} "><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="eyebrow">{{role==='merchant'?'MERCHANT WORKSPACE':'PARTNER WORKSPACE'}}</view><view class="heading-title">{{role==='merchant'?merchant.name:agent.name}}</view><view class="subtitle">{{role==='merchant'?'每一份用心，都让好生意更进一步。':'连接区域好店，让价值持续流转。'}}</view><view class="metric-grid"><view class="metric"><text>{{wallet.availableBets}}</text><text class="metric-label">可用权益 / 注</text></view><view class="metric"><text>{{wallet.frozenBets}}</text><text class="metric-label">冻结 / 注</text></view><view class="metric"><text>{{role==='merchant'?ownActivities.length:merchants.length}}</text><text class="metric-label">{{role==='merchant'?'营销活动':'名下商户'}}</text></view></view><view class="card"><view class="card-title">经营工具</view><view class="menu-row" wx:for="{{consoleMenus}}" wx:key="path" bindtap="open" data-path="{{item.path}}" data-query="{{item.query}}"><view class="left"><text class="menu-icon">{{item.icon}}</text>{{item.name}}</view><text class="arrow">›</text></view></view><view class="note">当前{{role==='merchant'?'商户':'代理'}}上下文已独立。切换身份后返回对应工作台，库存与货款分开展示。</view></block></view>
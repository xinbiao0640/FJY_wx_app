<view class="page {{role}} tab-page"><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="eyebrow">DISCOVER SOMETHING LOVELY</view><view class="heading-title">发现身边的小幸运</view><view class="subtitle">逛逛好店，好心情和好礼都在这里。</view><scroll-view scroll-x class="filter-scroll"><view wx:for="{{filters}}" wx:key="*this" class="filter-chip {{filter===item?'active':''}}" bindtap="selectFilter" data-value="{{item}}">{{item}}</view></scroll-view><view class="activity-card" wx:for="{{activities}}" wx:key="id" bindtap="openActivity" data-id="{{item.id}}"><view class="activity-cover {{item.color}}"><view class="cover-kicker">A LITTLE LUCK, A LOVELY DAY</view><view class="cover-name">{{item.merchant}}</view><view class="cover-art">{{item.color==='tea'?'茶':item.color==='market'?'礼':'啡'}}</view><text class="cover-badge">{{item.playType}}</text></view><view class="activity-body"><view class="activity-name">{{item.name}}</view><view class="merchant-name">⌂ {{item.merchant}}</view><view class="activity-bottom"><text class="reward-tag">✧ 有机会获得 {{item.betCount}} 注权益</text><text class="join-link">去参与 →</text></view></view></view><view wx:if="{{!activities.length}}" class="empty"><view class="symbol">✧</view><view class="title">好礼正在准备中</view><view class="desc">试试其他玩法，发现更多活动</view></view></block></view>
<import src="../../templates/subject-review.wxml"/>
<view class="page {{role}}"><include src="../../templates/load-status.wxml"/><view wx:if="{{denied}}" class="denied">{{denied}}<button class="primary" bindtap="home">返回首页</button></view><block wx:else><view class="eyebrow">BUILD SOMETHING TOGETHER</view><view class="heading-title">与好生意，一起成长</view><view class="subtitle">采购权益、自主定价，连接区域里的更多好店。</view><template wx:if="{{agent}}" is="subject-review" data="{{subject:agent}}"/><view wx:else class="card" style="margin-top:35rpx"><view class="field" wx:for="{{fields}}" wx:key="key"><text class="field-label">{{item.label}}</text><input value="{{form[item.key]}}" data-field="{{item.key}}" bindinput="input" placeholder="请填写{{item.label}}"/></view><view class="note">提交申请后等待平台审核，通过后可使用代理工作台。本期为单级代理采购转售模式，无自动佣金。</view><button class="primary" bindtap="applyAgent" loading="{{busy}}" disabled="{{busy||loading||!!loadError}}">提交代理申请</button></view></block></view>
